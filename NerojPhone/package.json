{
    "name": "nerojphone",
    "private": true,
    "packageManager": "npm@11.6.2",
    "scripts": {
        "build": "turbo run build",
        "dev": "turbo run dev",
        "lint": "turbo run lint",
        "format": "prettier --write \"**/*.{ts,tsx,md}\""
    },
    "devDependencies": {
        "prettier": "^3.0.0",
        "turbo": "latest"
    },
    "workspaces": [
        "apps/*",
        "packages/*"
    ],
    "overrides": {
        "glob": ">=10.5.0",
        "tmp": ">=0.2.3"
    }
}