# QI Card Payment Gateway Configuration
# Copy this file to .env.local and replace with your real merchant credentials
# Documentation: https://developers-gate.qi.iq/

# ============================================
# QI CARD AUTHENTICATION
# ============================================

# Basic Authentication Credentials (provided by QI Card)
QICARD_USERNAME=your_username_here
QICARD_PASSWORD=your_password_here

# Terminal ID - REQUIRED for all API requests (provided by QI Card)
QICARD_TERMINAL_ID=your_terminal_id_here

# QI Card Public Key - For webhook signature verification (provided by QI Card)
# This should be a multi-line RSA public key in PEM format
QICARD_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----
YOUR_PUBLIC_KEY_HERE
-----END PUBLIC KEY-----"

# ============================================
# QI CARD API ENDPOINTS
# ============================================

# Sandbox/Test Environment (for development)
QICARD_API_URL=https://uat-sandbox-3ds-api.qi.iq/api/v1

# Production Environment (uncomment when going live)
# QICARD_API_URL=https://api.qi.iq/api/v1

# ============================================
# APPLICATION SETTINGS
# ============================================

# Your application base URL (for return URLs and webhooks)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ============================================
# SUPABASE CONFIGURATION
# ============================================
# (if not already set)
# NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
